# Scryvorn Environment Variables
# Copy this file to .env.local and replace placeholders with real values

# AI API Configuration (OpenAI-compatible)
AI_API_KEY=your-api-key-placeholder-here
AI_API_BASE_URL=https://api.example.com/v1
AI_MODEL=your-model-name-placeholder

# Domain Age Lookup Service
# Optional / currently disabled in code
DOMAIN_AGE_API_URL=https://api.example.com/domain-age
DOMAIN_AGE_API_KEY=your-domain-age-api-key-placeholder
